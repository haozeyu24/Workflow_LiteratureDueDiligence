.DS_Store
__pycache__/
*.pyc

# Run outputs can be large and are regenerated by the workflow.
runs/*/artifacts/
runs/*/reports/
runs/*/downloads/
runs/*/logs/
runs/*/passes/pass_*/artifacts/
runs/*/passes/pass_*/reports/
runs/*/passes/pass_*/downloads/
runs/*/passes/pass_*/logs/
runs/*/passes/pass_*/artifacts/fulltext_import/PMC_XML/
runs/*/passes/pass_*/artifacts/fulltext_import/PMC_XML/normalized/
runs/*/passes/pass_*/artifacts/fulltext_import/PDF/
runs/*/passes/pass_*/artifacts/fulltext_import/PDFs/
runs/*/passes/pass_*/artifacts/fulltext_import/pdfs/
runs/*/passes/pass_*/artifacts/fulltext_import/downloads/
runs/*/passes/pass_*/artifacts/fulltext_import/**/*.pdf
runs/*/passes/pass_*/artifacts/metadata_collection/records/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/
runs/*/Phase1_PubmedCollection/passes/pass_*/reports/
runs/*/Phase1_PubmedCollection/passes/pass_*/downloads/
runs/*/Phase1_PubmedCollection/passes/pass_*/logs/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/PMC_XML/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/PMC_XML/normalized/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/PDF/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/PDFs/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/pdfs/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/downloads/
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/fulltext_import/**/*.pdf
runs/*/Phase1_PubmedCollection/passes/pass_*/artifacts/metadata_collection/records/

# Keep run definitions versioned so completed runs remain reproducible.
!runs/README.md
!runs/*/
!runs/*/passes/
!runs/*/passes/pass_*/
